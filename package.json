{
  "name": "neurobreak",
  "private": true,
  "version": "1.0.1",
  "description": "NeuroBreak",
  "author": "juanjube",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.1.2",
    "@fontsource-variable/noto-sans": "^5.1.1",
    "@google/genai": "^1.40.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.94.1",
    "flag-icons": "^7.5.0",
    "material-symbols": "^0.27.2",
    "openai": "^6.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.neurobreak.app",
    "productName": "NeuroBreak",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "NeuroBreak-Portable-${version}.exe"
    },
    "npmRebuild": false
  }
}
